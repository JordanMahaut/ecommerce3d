generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "mysql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

model User {
  id        Int    @id @default(autoincrement())
  firstname String
  lastname  String
  email     String @unique
  password  String
  role      Role   @default(USER)

  emailVerified            Boolean   @default(false)
  emailVerificationToken   String?   @unique
  emailVerificationExpires DateTime?

  passwordResetToken   String?   @unique
  passwordResetExpires DateTime?

  orders    Order[]
  quotes    Quote[]
  addresses Address[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Address {
  id         Int         @id @default(autoincrement())
  type       AddressType
  firstname  String
  lastname   String
  company    String?
  street     String
  street2    String?
  postalCode String
  city       String
  country    String      @default("France")
  phone      String?
  isDefault  Boolean     @default(false)

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Product {
  id          Int    @id @default(autoincrement())
  name        String
  slug        String @unique
  description String

  price Decimal @db.Decimal(10, 2)
  stock Int     @default(0)

  image   String?
  gallery Json?

  featured Boolean @default(false)
  isActive Boolean @default(true)

  categoryId Int?
  category   Category? @relation(fields: [categoryId], references: [id])

  orderItems OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
}

model Category {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  slug        String  @unique
  description String?
  image       String?
  isActive    Boolean @default(true)

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Order {
  id        Int    @id @default(autoincrement())
  reference String @unique

  subtotal     Decimal @db.Decimal(10, 2)
  shippingCost Decimal @default(0) @db.Decimal(10, 2)
  discount     Decimal @default(0) @db.Decimal(10, 2)
  total        Decimal @db.Decimal(10, 2)

  status        OrderStatus   @default(REQUESTED)
  paymentStatus PaymentStatus @default(NOT_STARTED)

  customerEmail String
  customerNote  String? @db.Text

  rejectionReason    String? @db.Text
  cancellationReason String? @db.Text

  /**
   * Estimation communiquée au client
   */
  estimatedShippingAt DateTime?

  /**
   * Dates de suivi de la commande
   */
  approvedAt        DateTime?
  rejectedAt        DateTime?
  paidAt            DateTime?
  printingStartedAt DateTime?
  readyAt           DateTime?
  shippedAt         DateTime?
  deliveredAt       DateTime?
  cancelledAt       DateTime?

  shippingMethod ShippingMethod

  relayPointId   String?
  relayPointName String?

  /**
   * Adresse de livraison sauvegardée au moment de la commande
   */
  shippingFirstname  String
  shippingLastname   String
  shippingCompany    String?
  shippingStreet     String
  shippingStreet2    String?
  shippingPostalCode String
  shippingCity       String
  shippingCountry    String
  shippingPhone      String?

  /**
   * Adresse de facturation sauvegardée au moment de la commande
   */
  billingFirstname  String
  billingLastname   String
  billingCompany    String?
  billingStreet     String
  billingStreet2    String?
  billingPostalCode String
  billingCity       String
  billingCountry    String
  billingPhone      String?

  userId Int
  user   User @relation(fields: [userId], references: [id])

  /**
   * Une commande possède au maximum un devis
   */
  quoteId Int?   @unique
  quote   Quote? @relation(fields: [quoteId], references: [id], onDelete: SetNull)

  items    OrderItem[]
  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([paymentStatus])
  @@index([shippingMethod])
  @@index([createdAt])
}

model OrderItem {
  id       Int     @id @default(autoincrement())
  quantity Int
  price    Decimal @db.Decimal(10, 2)

  productName  String
  productSlug  String?
  productImage String?

  orderId Int
  order   Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId Int?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([productId])
}

model Payment {
  id        Int    @id @default(autoincrement())
  reference String @unique

  amount   Decimal @db.Decimal(10, 2)
  currency String  @default("EUR")

  type     PaymentType
  provider PaymentProvider
  method   PaymentMethod?
  status   PaymentTransactionStatus @default(PENDING)

  providerPaymentId String? @unique
  providerSessionId String? @unique
  providerCaptureId String? @unique
  providerRefundId  String? @unique

  checkoutUrl String? @db.Text

  failureCode    String?
  failureMessage String? @db.Text

  authorizedAt DateTime?
  paidAt       DateTime?
  failedAt     DateTime?
  cancelledAt  DateTime?
  refundedAt   DateTime?
  expiresAt    DateTime?

  metadata Json?

  orderId Int
  order   Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([status])
  @@index([provider])
}

model Quote {
  id        Int    @id @default(autoincrement())
  reference String @unique

  /**
   * Informations du client
   */
  name  String
  email String
  phone String?

  /**
   * Demande initiale du client
   */
  message     String @db.Text
  serviceType String

  status QuoteStatus @default(PENDING)

  /**
   * Contenu préparé par l'administrateur
   */
  title       String?
  description String? @db.Text

  subtotal     Decimal? @db.Decimal(10, 2)
  shippingCost Decimal? @default(0) @db.Decimal(10, 2)
  discount     Decimal? @default(0) @db.Decimal(10, 2)
  total        Decimal? @db.Decimal(10, 2)

  /**
   * Paiement total ou acompte
   */
  depositPercentage Int?
  depositAmount     Decimal? @db.Decimal(10, 2)
  balanceAmount     Decimal? @db.Decimal(10, 2)

  /**
   * Délai de traitement communiqué par l'administrateur
   */
  processingMinDays Int?
  processingMaxDays Int?

  /**
   * Notes et réponses administratives
   */
  adminNote       String? @db.Text
  rejectionReason String? @db.Text

  /**
   * Validité et historique du devis
   */
  validUntil  DateTime?
  sentAt      DateTime?
  acceptedAt  DateTime?
  rejectedAt  DateTime?
  expiredAt   DateTime?
  cancelledAt DateTime?

  attachmentUrl String? @db.Text

  userId Int?
  user   User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  /**
   * Relation inverse avec la commande
   */
  order Order?

  answers QuoteAnswer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([validUntil])
}

model QuoteQuestion {
  id Int @id @default(autoincrement())

  label       String
  description String?           @db.Text
  type        QuoteQuestionType

  options Json?

  isRequired Boolean @default(false)
  isActive   Boolean @default(true)
  position   Int     @default(0)

  answers QuoteAnswer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, position])
}

model QuoteAnswer {
  id Int @id @default(autoincrement())

  value Json

  quoteId Int
  quote   Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  questionId Int
  question   QuoteQuestion @relation(fields: [questionId], references: [id])

  createdAt DateTime @default(now())

  @@unique([quoteId, questionId])
  @@index([quoteId])
  @@index([questionId])
}

enum QuoteQuestionType {
  TEXT
  TEXTAREA
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  BOOLEAN
  NUMBER
  FILE
}

enum Role {
  USER
  ADMIN
}

enum AddressType {
  SHIPPING
  BILLING
}

enum OrderStatus {
  REQUESTED
  UNDER_REVIEW
  NEEDS_INFORMATION
  APPROVED
  AWAITING_PAYMENT
  PARTIALLY_PAID
  PAID
  PRINTING
  READY
  SHIPPED
  DELIVERED
  REJECTED
  CANCELLED
}

enum PaymentStatus {
  NOT_STARTED
  PENDING
  PARTIALLY_PAID
  PAID
  FAILED
  CANCELLED
  PARTIALLY_REFUNDED
  REFUNDED
}

enum PaymentProvider {
  STRIPE
  PAYPAL
}

enum PaymentMethod {
  CARD
  KLARNA
  PAYPAL
  PAYPAL_PAY_LATER
}

enum PaymentType {
  FULL_PAYMENT
  DEPOSIT
  BALANCE
  ADDITIONAL_PAYMENT
}

enum PaymentTransactionStatus {
  PENDING
  REQUIRES_ACTION
  AUTHORIZED
  PROCESSING
  PAID
  FAILED
  CANCELLED
  EXPIRED
  PARTIALLY_REFUNDED
  REFUNDED
}

enum QuoteStatus {
  PENDING
  UNDER_REVIEW
  NEEDS_INFORMATION
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  CONVERTED_TO_ORDER
  CANCELLED
}

enum NotificationType {
  ORDER_CREATED
  QUOTE_CREATED
  ORDER_UPDATED
  PAYMENT_RECEIVED
  SYSTEM
}

enum ShippingMethod {
  COLISSIMO
  MONDIAL_RELAY
  CHRONOPOST
  PICKUP
}

model Notification {
  id       Int              @id @default(autoincrement())
  type     NotificationType
  title    String
  message  String
  link     String?
  isRead   Boolean          @default(false)
  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isRead, createdAt])
  @@index([type])
}

model Question {
  id          Int          @id @default(autoincrement())
  label       String
  description String?
  placeholder String?
  type        QuestionType
  required    Boolean      @default(false)
  active      Boolean      @default(true)
  position    Int
  options     Json?
  validation  Json?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

enum QuestionType {
  TEXT
  TEXTAREA
  NUMBER
  EMAIL
  PHONE
  SELECT
  RADIO
  CHECKBOX
  FILE
  COLOR
  DIMENSIONS
}
